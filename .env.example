# SQLite database file (directory is created automatically)
DATABASE_URL=data/self-sport.db

# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to localhost (or your server's domain)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: comma-separated athlete IDs allowed to sign in.
# Empty = the first athlete who connects becomes the only allowed one.
ALLOWED_ATHLETE_IDS=

# Background Strava sync interval in minutes (0 disables)
SYNC_INTERVAL_MINUTES=60
